{
  "name": "policia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace @policia/client",
    "dev:server": "npm run dev --workspace @policia/server",
    "build": "npm run typecheck && npm run build --workspace @policia/client",
    "build:client": "npm run build --workspace @policia/client",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "npm run preview --workspace @policia/client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24"
  }
}
