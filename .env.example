# AI provider: mock | gemini
# mock es determinista y no llama a ningún servicio externo.
AI_PROVIDER=mock

# Gemini credentials. Server-side only; never prefix with VITE_.
GEMINI_API_KEY=
# Modelo de texto. Por defecto: gemini-3.5-flash-lite.
# Los modelos flash completos pueden devolver 503 con la cuota gratuita.
GEMINI_MODEL_TEXT=gemini-3.5-flash-lite
# Modelo con visión para transcribir imagen/PDF. Si se deja vacío se usa
# gemini-3.5-flash-lite.
GEMINI_MODEL_VISION=
# Presupuesto interno de generación en milisegundos (máx. 55000).
GEMINI_PRESUPUESTO_MS=48000
# Presupuesto interno de transcripción en milisegundos (máx. 50000).
GEMINI_PRESUPUESTO_TRANSCRIPCION_MS=35000

# Límite de peticiones por IP y ventana (por defecto, 10 minutos).
LIMITE_GENERAR=10
LIMITE_TRANSCRIBIR=10
LIMITE_EXPORTAR=30

# Local API
PORT=3001

# Netlify Basic Auth. Set the same values in the Netlify UI.
APP_USER=
APP_PASSWORD=
