# AI provider: mock | gemini
# mock es determinista y no llama a ningún servicio externo.
AI_PROVIDER=mock

# Gemini credentials. Server-side only; never prefix with VITE_.
GEMINI_API_KEY=
# Modelo de texto. Por defecto: gemini-3.8-flash.
GEMINI_MODEL_TEXT=gemini-3.8-flash
# Modelo con visión para la futura transcripción de imagen/PDF.
GEMINI_MODEL_VISION=
# Presupuesto interno de generación en milisegundos (máx. 55000).
GEMINI_PRESUPUESTO_MS=48000

# Local API
PORT=3001

# Netlify Basic Auth. Set the same values in the Netlify UI.
APP_USER=
APP_PASSWORD=
